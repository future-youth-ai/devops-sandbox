# -------- 飞书自建应用 --------
# https://open.feishu.cn/app → 凭证与基础信息
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxx

# -------- 飞书事件订阅 --------
# https://open.feishu.cn/app → 事件订阅 → 加密策略
FEISHU_EVENT_ENCRYPT_KEY=32-char-base64-key
FEISHU_EVENT_VERIFICATION_TOKEN=deprecated-keep-empty-if-v2
# V2 模式下只需要 encrypt_key, Verification Token 可留空

# -------- 飞书资源 ID --------
# Bitable 会议索引表
FEISHU_BITABLE_APP_TOKEN=bascnxxxxxxxxxxxxxxxxxxxx
FEISHU_BITABLE_TABLE_ID=tblxxxxxxxxxxxxxx

# 会议纪要文档模板 (存放在 Wiki 或云空间)
FEISHU_DOC_TEMPLATE_TOKEN=doxcnxxxxxxxxxxxxxxxxxxxx

# 群消息目标 chat_id (会议总结通知群)
FEISHU_SUMMARY_CHAT_ID=oc_xxxxxxxxxxxxxxxxxxxxxxxx

# -------- SMTP (发邮件) --------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=bot@example.com
SMTP_PASSWORD=change-me
SMTP_FROM_ADDRESS="Meeting Bot <bot@example.com>"
SMTP_USE_TLS=true

# -------- 服务配置 --------
APP_BASE_URL=https://bot.example.com
APP_LOG_LEVEL=INFO
APP_SQLITE_PATH=./data/dedup.sqlite
APP_WORKERS=2
