# ai-review 环境变量模板 - 实际部署时复制为 .env 并填入真实值
# 禁止把 .env 提交到仓库

# ---------- App ----------
APP_NAME=ai-review
APP_ENV=production
LOG_LEVEL=INFO

# ---------- LLM provider (stub, 部署方决定具体 provider) ----------
# LLM_API_KEY=sk-xxxx
# LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ---------- RAG ----------
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=8

# ---------- 审核限制 ----------
REVIEW_MAX_DOC_MB=50
